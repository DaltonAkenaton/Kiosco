{
  // Configuracion de TypeScript COMPARTIDA por todos los proyectos del monorepo.
  // Cada app tiene su propio tsconfig.json que hace "extends" de este archivo
  // y solo agrega lo que cambia. Asi las reglas estrictas se definen una sola vez.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    // --- Modo estricto (exigido por ARQUITECTURA.md seccion 14) ---
    // "strict" enciende de golpe ~8 reglas que obligan a que ningun valor
    // pueda ser null/undefined por accidente. Molesta al principio,
    // pero evita la mayoria de los errores en produccion.
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // --- Calidad de vida ---
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // --- Atajos de importacion ---
    // Permite escribir  import { CONFIG } from '@kiosko/compartido'
    // en vez de  import { CONFIG } from '../../../packages/compartido/src'
    //
    // Las rutas de abajo se interpretan RELATIVAS A ESTE ARCHIVO, que esta en
    // la raiz del monorepo. Por eso los proyectos que hacen "extends" de el
    // no necesitan repetirlas ni declarar "baseUrl" (opcion que TypeScript 6
    // marco como obsoleta).
    "paths": {
      "@kiosko/compartido": ["./packages/compartido/src/index.ts"],
      "@kiosko/compartido/*": ["./packages/compartido/src/*"]
    }
  }
}
