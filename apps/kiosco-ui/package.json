{
  "name": "@kiosko/kiosco-ui",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node generar-tema.mjs",
    "start": "ng serve",
    "prebuild": "node generar-tema.mjs",
    "build": "ng build",
    "tema:generar": "node generar-tema.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postbuild": "node verificar-compilado.mjs",
    "verificar:compilado": "node verificar-compilado.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.5",
    "@angular/cli": "^21.1.5",
    "@angular/compiler-cli": "^21.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "tailwindcss": "^4.1.14",
    "@tailwindcss/postcss": "^4.1.14",
    "postcss": "^8.5.6"
  },
  "description": "Interfaz del kiosco (Angular) que corre dentro de Electron"
}
